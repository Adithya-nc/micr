create table public.rs_cases (
  case_id text primary key,
  customer_id text not null,
  ticket_id text,
  raw_complaint text not null,
  primary_intent text,
  secondary_intent text,
  domain text[],
  urgency text,
  sentiment text,
  sla_state text,
  status text not null default 'NEW' check (status in ('NEW','ROUTED','CONTEXT_BUILT','INVESTIGATING','EVIDENCE_GAP','CONTRADICTION','EVIDENCE_READY','DECISION_READY','APPROVAL_REQUIRED','ACTION_EXECUTING','VERIFYING','RESOLVED','REOPENED','ESCALATED','FAILED')),
  current_stage text,
  risk_level text,
  authorization_state text,
  action_status text,
  verification_status text,
  final_state text,
  escalation_reason text,
  reopened_count int not null default 0,
  parent_case_id text references public.rs_cases(case_id),
  label text not null default 'SYNTHETIC',
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);
alter table public.rs_cases enable row level security;
create policy rs_cases_select on public.rs_cases for select using (true);

create table public.rs_case_twins (
  case_id text primary key references public.rs_cases(case_id),
  twin jsonb not null,
  created_at timestamptz not null default now()
);
alter table public.rs_case_twins enable row level security;
create policy rs_case_twins_select on public.rs_case_twins for select using (true);

create table public.rs_evidence_ledger (
  evidence_id text primary key,
  case_id text not null references public.rs_cases(case_id),
  source_system text not null,
  source_record_id text not null,
  source_type text not null,
  field_name text not null,
  value jsonb not null,
  authority_level text not null,
  observed_at timestamptz not null,
  retrieved_at timestamptz not null,
  freshness_status text not null,
  retrieval_method text not null,
  relevance text not null,
  status text not null default 'ACTIVE',
  created_at timestamptz not null default now()
);
alter table public.rs_evidence_ledger enable row level security;
create policy rs_evidence_ledger_select on public.rs_evidence_ledger for select using (true);

create table public.rs_decisions (
  decision_id text primary key,
  case_id text not null references public.rs_cases(case_id),
  contract_hash text not null,
  contract_version text not null default '1.0',
  evidence_ids text[] not null,
  policy_id text,
  policy_version text,
  risk_score int not null,
  risk_factors jsonb not null default '{}'::jsonb,
  auth_state text not null,
  decision text not null,
  reason_codes text[] not null default '{}',
  created_at timestamptz not null default now()
);
alter table public.rs_decisions enable row level security;
create policy rs_decisions_select on public.rs_decisions for select using (true);

create table public.rs_actions (
  action_id text primary key,
  case_id text not null references public.rs_cases(case_id),
  contract_hash text not null,
  decision_id text references public.rs_decisions(decision_id),
  action_type text not null,
  target_id text not null,
  amount numeric,
  currency text,
  idempotency_key text not null unique,
  status text not null,
  retry_count int not null default 0,
  error_code text,
  request_payload jsonb,
  response_payload jsonb,
  simulated boolean not null default true,
  created_at timestamptz not null default now(),
  completed_at timestamptz
);
alter table public.rs_actions enable row level security;
create policy rs_actions_select on public.rs_actions for select using (true);

create table public.rs_idempotency_ledger (
  idempotency_key text primary key,
  case_id text not null references public.rs_cases(case_id),
  action_type text not null,
  target_id text not null,
  contract_hash text not null,
  status text not null,
  action_id text references public.rs_actions(action_id),
